# Psalm of Creation — bare words are symbols; no declaration of
# type is needed, for every unnamed thing is still a named spirit.
BEGIN CREATION
  DECLARE heart AS pure
  DECLARE hands AS willing
  IF heart IS pure THEN
    IF hands IS willing THEN
      REVEAL("the work is blessed")
    ELSE
      REVEAL("wait and be still")
    ENDIF
  ELSE
    REVEAL("first, be cleansed")
  ENDIF
  ASCEND
END CREATION
